{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportMachine agent attempt envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "agent_name": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "lane_id": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "minimum": 1},
    "agent_prompt_sha256": {"type": "string", "minLength": 1},
    "effective_prompt_path": {"type": "string", "minLength": 1},
    "input_artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    },
    "output_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "model": {"type": "string"},
    "model_reasoning_effort": {"type": "string"},
    "command": {
      "type": "array",
      "items": {"type": "string"}
    },
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": ["string", "null"]},
    "exit_code": {"type": ["integer", "null"]},
    "status": {
      "type": "string",
      "enum": ["started", "completed", "failed", "skipped"]
    },
    "result_summary_path": {"type": ["string", "null"]},
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "version",
    "run_id",
    "agent_name",
    "phase",
    "attempt",
    "agent_prompt_sha256",
    "effective_prompt_path",
    "input_artifact_hashes",
    "started_at",
    "status"
  ]
}
