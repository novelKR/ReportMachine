{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportMachine evidence gap map",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "extra_research_recommended": {"type": "boolean"},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gap_id": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "minLength": 1},
          "importance": {"type": "string", "enum": ["p0", "p1", "p2"]},
          "description": {"type": "string", "minLength": 1},
          "gap_kind": {
            "type": "string",
            "enum": [
              "issuer_only",
              "no_direct_evidence",
              "stale_evidence",
              "unprocessed_document",
              "absence_claim_unlogged",
              "unit_mismatch",
              "unresolved_conflict"
            ]
          },
          "suggested_lane_id": {"type": "string"},
          "suggested_queries": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "required": ["gap_id", "question_id", "importance", "description", "gap_kind"]
      }
    }
  },
  "required": ["version", "run_id", "extra_research_recommended", "gaps"]
}
