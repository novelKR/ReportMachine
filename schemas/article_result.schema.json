{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "article_type": {
      "type": "string",
      "enum": ["industry", "earnings", "preview"]
    },
    "analysis_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "industry_structure",
          "company_fundamental",
          "market_reaction",
          "event_analysis",
          "earnings_quality",
          "technology_validation"
        ]
      }
    },
    "article_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the frozen article.md content."
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "one_sentence_insight": {
      "type": "string"
    },
    "scorecard": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "headline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "leading_indicators": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "transparency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "execution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "total",
        "headline",
        "quality",
        "leading_indicators",
        "transparency",
        "execution",
        "summary"
      ]
    },
    "output_files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "article_md": {
          "type": "string"
        },
        "source_ledger_csv": {
          "type": "string"
        },
        "image_ledger_csv": {
          "type": "string"
        },
        "claim_ledger_json": {
          "type": "string"
        },
        "preflight_result_json": {
          "type": "string"
        },
        "run_manifest_json": {
          "type": "string"
        },
        "research_appendix_md": {
          "type": ["string", "null"]
        },
        "paragraph_map_json": {
          "type": ["string", "null"]
        },
        "final_sync_report_json": {
          "type": ["string", "null"]
        },
        "earnings_delta_matrix_json": {
          "type": ["string", "null"]
        },
        "earnings_delta_matrix_md": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "article_md",
        "source_ledger_csv",
        "image_ledger_csv",
        "claim_ledger_json",
        "preflight_result_json",
        "run_manifest_json"
      ]
    },
    "critical_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checklist_status": {
      "type": "string",
      "enum": ["pass", "pass_with_warnings", "fail"]
    }
  },
  "required": [
    "article_type",
    "article_sha256",
    "title",
    "subtitle",
    "one_sentence_insight",
    "scorecard",
    "output_files",
    "critical_warnings",
    "checklist_status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "article_type": {
            "const": "earnings"
          },
          "checklist_status": {
            "enum": ["pass", "pass_with_warnings"]
          }
        },
        "required": ["article_type", "checklist_status"]
      },
      "then": {
        "properties": {
          "scorecard": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "article_type": {
            "const": "earnings"
          },
          "checklist_status": {
            "const": "fail"
          }
        },
        "required": ["article_type", "checklist_status"]
      },
      "then": {
        "properties": {
          "scorecard": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "article_type": {
            "const": "industry"
          }
        },
        "required": ["article_type"]
      },
      "then": {
        "properties": {
          "scorecard": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "article_type": {
            "const": "preview"
          }
        },
        "required": ["article_type"]
      },
      "then": {
        "properties": {
          "checklist_status": {
            "const": "fail"
          }
        }
      }
    }
  ]
}
