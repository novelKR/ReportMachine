{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportMachine editorial red team report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "strongest_counter_thesis": {"type": "string", "minLength": 1},
    "alternative_causes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "overweighted_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "underweighted_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "unfair_comparisons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "single_source_that_would_flip": {"type": "string", "minLength": 1},
    "overread_risk_sentences": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verdict": {
      "type": "string",
      "enum": ["thesis_durable", "thesis_needs_qualification", "thesis_unsupported"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": {"type": "string", "pattern": "^RT-[0-9]+$"},
          "priority": {"type": "string", "enum": ["blocking", "high", "normal"]},
          "issue": {"type": "string", "minLength": 1},
          "required_fix": {"type": "string", "minLength": 1}
        },
        "required": ["issue_id", "priority", "issue", "required_fix"]
      }
    }
  },
  "required": [
    "version",
    "run_id",
    "strongest_counter_thesis",
    "alternative_causes",
    "single_source_that_would_flip",
    "verdict",
    "issues"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": ["thesis_needs_qualification", "thesis_unsupported"]
          }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "type": "object",
              "properties": {"priority": {"const": "blocking"}},
              "required": ["priority"]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
