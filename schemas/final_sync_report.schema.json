{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportMachine final sync audit report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "article_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    },
    "regenerated_after_freeze": {"const": true},
    "status": {
      "type": "string",
      "enum": ["pass", "pass_with_warnings", "fail"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["pass", "warn", "fail", "skipped"]
          },
          "details": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "required": ["check_id", "status", "details"]
      }
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "version",
    "run_id",
    "generated_at",
    "article_sha256",
    "regenerated_after_freeze",
    "status",
    "checks",
    "errors",
    "warnings"
  ]
}
