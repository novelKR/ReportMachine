{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "delta_table": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric_or_theme": {
            "type": "string"
          },
          "previous_period_value_or_language": {
            "type": "string"
          },
          "current_period_value_or_language": {
            "type": "string"
          },
          "change_type": {
            "type": "string"
          },
          "company_frame": {
            "type": "string"
          },
          "counter_interpretation": {
            "type": "string"
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scorecard_axis": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "next_quarter_watchpoint": {
            "type": "string"
          }
        },
        "required": [
          "metric_or_theme",
          "previous_period_value_or_language",
          "current_period_value_or_language",
          "change_type",
          "company_frame",
          "counter_interpretation",
          "evidence_source_ids",
          "scorecard_axis",
          "confidence",
          "next_quarter_watchpoint"
        ]
      }
    },
    "disappeared_highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wording_shifts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guidance_assumption_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ir_frame": {
      "type": "string"
    },
    "counter_reading": {
      "type": "string"
    },
    "scorecard_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "headline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "leading_indicators": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "transparency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "execution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "total",
        "headline",
        "quality",
        "leading_indicators",
        "transparency",
        "execution",
        "summary"
      ]
    },
    "next_quarter_verification_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "delta_table",
    "disappeared_highlights",
    "wording_shifts",
    "guidance_assumption_changes",
    "ir_frame",
    "counter_reading",
    "scorecard_candidate",
    "next_quarter_verification_points"
  ]
}
