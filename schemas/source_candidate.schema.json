{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportMachine source candidate (one JSONL row)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "source_id": {
      "type": "string",
      "minLength": 1,
      "description": "Runner-assigned source ledger id after research candidate ingest."
    },
    "lane_id": {"type": "string"},
    "question_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "search_intent": {
      "type": "string",
      "enum": ["confirming", "disconfirming", "context"]
    },
    "title": {"type": "string", "minLength": 1},
    "url": {"type": ["string", "null"]},
    "local_path": {"type": ["string", "null"]},
    "issuer": {"type": "string"},
    "source_role": {"type": "string"},
    "doc_kind": {"type": "string"},
    "publication_date": {"type": ["string", "null"]},
    "why_relevant": {"type": "string"},
    "expected_evidence_class": {
      "type": "string",
      "enum": [
        "observed_fact",
        "issuer_claim",
        "regulator_statement",
        "independent_measurement",
        "secondary_context",
        "analyst_inference",
        "absence_claim",
        "unknown"
      ]
    },
    "discovery_method": {"type": "string"},
    "not_found": {
      "type": "boolean",
      "description": "True when the lane concluded the material does not exist in accessible scope."
    },
    "ingest_status": {
      "type": "string",
      "enum": [
        "downloaded",
        "downloaded_hashed",
        "registered_local",
        "remote_manual_verified",
        "remote_unverified",
        "blocked",
        "stale"
      ]
    },
    "ingest_reason": {"type": "string"},
    "ingested_local_path": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"]},
    "extracted_text_path": {"type": ["string", "null"]},
    "text_status": {
      "type": ["string", "null"],
      "enum": ["ok", "partial", "empty", "unsupported", "tool_missing", "failed", null]
    },
    "search_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {"type": "string", "minLength": 1},
          "scope": {"type": "string"},
          "result": {"type": "string"}
        },
        "required": ["query", "scope"]
      }
    }
  },
  "required": ["candidate_id", "question_ids", "search_intent", "title", "why_relevant"],
  "allOf": [
    {
      "if": {
        "properties": {"not_found": {"const": true}},
        "required": ["not_found"]
      },
      "then": {
        "properties": {
          "search_log": {"type": "array", "minItems": 1},
          "ingest_status": {"type": "string", "enum": ["remote_unverified"]},
          "sha256": {"type": "null"},
          "ingested_local_path": {"type": "null"},
          "extracted_text_path": {"type": "null"},
          "text_status": {"type": "null"}
        },
        "required": ["search_log"]
      }
    }
  ]
}
