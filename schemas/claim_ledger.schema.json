{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "claim_id": {
        "type": "string"
      },
      "claim_text": {
        "type": "string"
      },
      "claim_type": {
        "type": "string"
      },
      "article_section": {
        "type": "string"
      },
      "article_anchor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "paragraph_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["heading", "paragraph_id"]
      },
      "claim_class": {
        "type": "string",
        "enum": [
          "observed_fact",
          "issuer_claim",
          "regulator_statement",
          "independent_measurement",
          "secondary_context",
          "analyst_inference",
          "absence_claim",
          "unknown"
        ]
      },
      "importance": {
        "type": "string",
        "enum": ["critical", "high", "normal"]
      },
      "evidence_ids": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "counterevidence_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "valid_as_of": {
        "type": ["string", "null"]
      },
      "source_ids": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "source_quote_or_datapoint": {
        "type": "string",
        "minLength": 1
      },
      "confidence": {
        "type": "string",
        "enum": ["high", "medium", "low"]
      },
      "support_status": {
        "type": "string",
        "enum": ["supported", "conditionally_supported", "unsupported", "needs_review"]
      },
      "needs_human_review": {
        "type": "boolean"
      },
      "reason": {
        "type": "string"
      }
    },
    "required": [
      "claim_id",
      "claim_text",
      "claim_type",
      "article_section",
      "article_anchor",
      "evidence_ids",
      "source_ids",
      "source_quote_or_datapoint",
      "confidence",
      "support_status",
      "needs_human_review"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "support_status": {
              "const": "conditionally_supported"
            }
          },
          "required": ["support_status"]
        },
        "then": {
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["reason"]
        }
      }
    ]
  }
}
