{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportMachine compression report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue_id": {"type": "string", "pattern": "^CMP-[0-9]+$"},
          "priority": {"type": "string", "enum": ["blocking", "high", "normal"]},
          "issue": {"type": "string", "minLength": 1},
          "required_fix": {"type": "string", "minLength": 1}
        },
        "required": ["issue_id", "priority", "issue", "required_fix"]
      }
    },
    "duplicate_claim_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "headings": {
            "type": "array",
            "items": {"type": "string"}
          },
          "occurrences": {"type": "integer", "minimum": 2},
          "recommended_action": {"type": "string", "minLength": 1}
        },
        "required": ["claim_ids", "occurrences", "recommended_action"]
      }
    },
    "appendix_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "required": ["heading", "reason"]
      }
    },
    "low_information_sections": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "estimated_reduction_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 90
    }
  },
  "required": ["version", "run_id", "issues", "duplicate_claim_clusters", "appendix_candidates"]
}
